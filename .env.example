# Timezone
TZ=Europe/Madrid

# Let's Encrypt — required by scripts/install.sh for certificate
# registration/expiry notices. Not read by docker-compose.yml.
CERTBOT_EMAIL=

# PostgreSQL
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me

# n8n
# N8N_HOST/N8N_PROTOCOL/N8N_PORT only shape the URLs n8n generates for
# itself (editor links, webhook links) — the container always listens
# on plain HTTP on N8N_PORT; TLS is terminated by the host nginx vhost.
N8N_HOST=automation.eyan.fyi
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://automation.eyan.fyi/

# Required for the CRM workflows (workflows/crm/), which read EYAN_API_BASE_URL
# (a plain URL, not a secret) via $env — this n8n version blocks $env access
# from node expressions by default. No workflow reads a secret via $env; both
# real secrets live only in n8n's encrypted credential store.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Encryption
N8N_ENCRYPTION_KEY=replace-with-random-key

# Redis
REDIS_PASSWORD=change-me

# CRM Automation Integration Contract (ADR-0019, eyan-ai-platform) — see
# docs/adrs/ADR-0006-crm-workflow-authentication.md. Also imported as two
# n8n-native credentials (HTTP Header Auth + Crypto) — see
# docs/security/credential-management.md. Must match the SAME values
# configured in eyan-ai-platform/backend/.env.
EYAN_API_BASE_URL=https://eyan.fyi/api/v1
AUTOMATION_SERVICE_API_KEY=replace-with-random-key
AUTOMATION_WEBHOOK_SIGNING_SECRET=replace-with-random-key

# AI Provider Contract (ADR-0020, eyan-ai-platform) — Workflow 3
# (workflows/crm/03-ai-qualification.json). Config-driven provider
# selection; only "ollama" has an implemented branch. host.docker.internal
# requires docker-compose.yml's extra_hosts entry on the n8n service and
# Ollama listening on an interface reachable from the container (see
# docs/adrs/ADR-0007).
AI_PROVIDER=ollama
AI_PROMPT_VERSION=v1
AI_MAX_RETRIES=3
AI_CONFIDENCE_HIGH_THRESHOLD=0.75
AI_CONFIDENCE_MEDIUM_THRESHOLD=0.4
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:7b
AI_OLLAMA_TIMEOUT_MS=300000
