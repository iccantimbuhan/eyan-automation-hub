# Timezone
TZ=Europe/Madrid

# Let's Encrypt — required by scripts/install.sh for certificate
# registration/expiry notices. Not read by docker-compose.yml.
CERTBOT_EMAIL=

# PostgreSQL
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me

# n8n
# N8N_HOST/N8N_PROTOCOL/N8N_PORT only shape the URLs n8n generates for
# itself (editor links, webhook links) — the container always listens
# on plain HTTP on N8N_PORT; TLS is terminated by the host nginx vhost.
N8N_HOST=automation.eyan.fyi
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://automation.eyan.fyi/

# Required for the CRM workflows (workflows/crm/), which read EYAN_API_BASE_URL
# (a plain URL, not a secret) via $env — this n8n version blocks $env access
# from node expressions by default. No workflow reads a secret via $env; both
# real secrets live only in n8n's encrypted credential store.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Encryption
N8N_ENCRYPTION_KEY=replace-with-random-key

# Redis
REDIS_PASSWORD=change-me

# CRM Automation Integration Contract (ADR-0019, eyan-ai-platform) — see
# docs/adrs/ADR-0006-crm-workflow-authentication.md. Also imported as two
# n8n-native credentials (HTTP Header Auth + Crypto) — see
# docs/security/credential-management.md. Must match the SAME values
# configured in eyan-ai-platform/backend/.env.
EYAN_API_BASE_URL=https://eyan.fyi/api/v1
AUTOMATION_SERVICE_API_KEY=replace-with-random-key
AUTOMATION_WEBHOOK_SIGNING_SECRET=replace-with-random-key

# AI Provider Contract (ADR-0020) is Sprint 5-superseded: Workflow 3 no
# longer selects a provider, loads a prompt, or runs its own retries -- it
# calls eyan-ai-platform's AI Core Capability instead
# (POST /ai-core/service/capabilities/lead-qualification/invoke, same
# EYAN_API_BASE_URL + AUTOMATION_SERVICE_API_KEY above). Provider/prompt/
# retry/confidence-threshold config now lives entirely in AI Core's
# AiRoutingPolicy (eyan-ai-platform), not here. AI_PROVIDER/OLLAMA_*/
# AI_MAX_RETRIES/AI_CONFIDENCE_*_THRESHOLD are no longer read by any
# workflow in this repo.

# Sales Automation (Sprint 5, Workflow 4 --
# workflows/crm/04-sales-automation.json). Each is independently optional --
# the corresponding step is skipped (not an error) if unset.
#
# Assignment: a v1 stand-in (a single configurable default owner), not a
# routing engine -- flagged as remaining technical debt in the Sprint 5
# report. Leave unset to skip auto-assignment entirely.
DEFAULT_SALES_OWNER_ID=
#
# Slack: a plain incoming-webhook URL read via $env, not an n8n credential
# -- unlike EYAN_API_BASE_URL this URL IS a bearer secret (anyone with it
# can post to the channel); treat it accordingly even though it's env-var
# config rather than the encrypted credential store. Leave unset to skip.
SLACK_WEBHOOK_URL=
#
# Email: SMTP credentials themselves are configured as an n8n-native "SMTP
# Account" credential (n8n UI, encrypted store — see
# docs/security/credential-management.md), never here. These two vars only
# supply the from/to addresses; leave SALES_NOTIFICATION_EMAIL_TO unset to
# skip the email step.
SALES_NOTIFICATION_EMAIL_FROM=sales-automation@eyan.fyi
SALES_NOTIFICATION_EMAIL_TO=

# WhatsApp Gateway (workflows/integrations/01-whatsapp-gateway-webhook.json).
# Shared secret Meta echoes back on GET .../whatsapp/webhook verification
# (hub.verify_token) -- must match the "Verify token" configured for this
# app's WhatsApp product in the Meta App Dashboard. A bearer-style secret
# with no dedicated n8n credential type, read via $env as a documented,
# narrow exception (see docs/security/credential-management.md).
WHATSAPP_VERIFY_TOKEN=replace-with-random-value

# WhatsApp Outbound Send (workflows/integrations/02-whatsapp-outbound-send.json).
# Both plain config, not secrets -- read via $env, same posture as
# EYAN_API_BASE_URL. Verify WHATSAPP_GRAPH_API_VERSION against Meta's
# current changelog rather than trusting this default indefinitely.
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=replace-with-your-phone-number-id

# WhatsApp Business Account ID -- not a secret, but lives in the "Meta
# WhatsApp Cloud API" n8n credential (see docs/security/credential-management.md),
# not read via $env by any node. Kept here only as a disaster-recovery
# re-import reference.
WHATSAPP_BUSINESS_ACCOUNT_ID=replace-with-your-waba-id

# WHATSAPP_ACCESS_TOKEN is intentionally absent from this file (and, by
# design, from the real .env too -- see docs/security/credential-management.md).
# It lives only inside n8n's encrypted credential store.
