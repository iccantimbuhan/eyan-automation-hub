# Timezone
TZ=Europe/Madrid

# Let's Encrypt — required by scripts/install.sh for certificate
# registration/expiry notices. Not read by docker-compose.yml.
CERTBOT_EMAIL=

# PostgreSQL
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me

# n8n
# N8N_HOST/N8N_PROTOCOL/N8N_PORT only shape the URLs n8n generates for
# itself (editor links, webhook links) — the container always listens
# on plain HTTP on N8N_PORT; TLS is terminated by the host nginx vhost.
N8N_HOST=automation.eyan.fyi
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://automation.eyan.fyi/

# Encryption
N8N_ENCRYPTION_KEY=replace-with-random-key

# Redis
REDIS_PASSWORD=change-me
