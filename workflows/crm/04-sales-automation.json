{
  "id": "CrmSalesAutomationWf01",
  "name": "CRM - 04 - Sales Automation",
  "nodes": [
    {
      "id": "n1",
      "name": "Webhook - Lead Qualified",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "webhookId": "crm-lead-qualified-01",
      "parameters": {
        "httpMethod": "POST",
        "path": "crm/lead-qualified",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      }
    },
    {
      "id": "n2",
      "name": "Prepare Verification Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Same HMAC verification shape as Workflow 1 (ADR-0019 Decision 1 / ADR-0006)\n// -- EYAN's CrmAutomationIngestService.applyQualificationResult() dispatches\n// this webhook (AutomationWebhookService.dispatchLeadQualified) the same way\n// CrmLeadService.create() dispatches Workflow 1's, same signing utility.\nconst item = $input.item;\nconst headers = item.json.headers || {};\nconst signatureHeader = String(headers['x-eyan-signature'] || '');\nconst timestampHeader = String(headers['x-eyan-timestamp'] || '');\n\nconst receivedSignature = signatureHeader.startsWith('sha256=')\n  ? signatureHeader.slice(7)\n  : signatureHeader;\n\nconst timestampMs = Number(timestampHeader);\nconst rawBody = item.binary && item.binary.data\n  ? Buffer.from(item.binary.data.data, 'base64').toString('utf8')\n  : '';\n\nconst FRESHNESS_WINDOW_MS = 5 * 60 * 1000;\nconst isFresh = Number.isFinite(timestampMs) && Math.abs(Date.now() - timestampMs) <= FRESHNESS_WINDOW_MS;\n\nreturn [{\n  json: {\n    hasSignature: signatureHeader.length > 0,\n    receivedSignature,\n    isFresh,\n    rawBody,\n    signedString: `${timestampHeader}.${rawBody}`,\n  },\n}];\n"
      }
    },
    {
      "id": "n3",
      "name": "Compute Expected Signature",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [440, 0],
      "parameters": {
        "action": "hmac",
        "binaryData": false,
        "value": "={{ $json.signedString }}",
        "type": "SHA256",
        "dataPropertyName": "computedSignature",
        "encoding": "hex"
      },
      "credentials": {
        "crypto": {
          "id": "WhSigSecretCred01",
          "name": "EYAN Webhook Signing Secret"
        }
      }
    },
    {
      "id": "n4",
      "name": "Verify & Parse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const prep = $('Prepare Verification Input').item.json;\nconst computed = $json.computedSignature;\n\nif (!prep.hasSignature || computed !== prep.receivedSignature) {\n  return [{ json: { valid: false, reason: 'Invalid signature.' } }];\n}\n\nif (!prep.isFresh) {\n  return [{ json: { valid: false, reason: 'Stale timestamp (outside the 5 minute freshness window).' } }];\n}\n\nlet payload;\ntry {\n  payload = JSON.parse(prep.rawBody);\n} catch (error) {\n  return [{ json: { valid: false, reason: 'Malformed JSON body.' } }];\n}\n\nif (!payload || !payload.lead || !payload.lead.id || !payload.qualification) {\n  return [{ json: { valid: false, reason: 'Missing lead/qualification payload.' } }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    lead: payload.lead,\n    qualification: payload.qualification,\n    pipelineStage: payload.pipelineStage,\n    contractVersion: payload.contractVersion,\n  },\n}];\n"
      }
    },
    {
      "id": "n5",
      "name": "Signature Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [880, 0],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }
        }
      }
    },
    {
      "id": "n6",
      "name": "Respond 202 Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1100, -280],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { received: true } }}",
        "options": { "responseCode": 202 }
      }
    },
    {
      "id": "n7",
      "name": "Respond 401 Invalid Signature",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [1100, 280],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: false, message: $json.reason } }}",
        "options": { "responseCode": 401 }
      }
    },
    {
      "id": "n8",
      "name": "Assignment Needed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1320, -280],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ !$json.lead.assignedToId && !!$env.DEFAULT_SALES_OWNER_ID }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }
        }
      }
    },
    {
      "id": "n9",
      "name": "Assign Salesperson",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [1540, -380],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.EYAN_API_BASE_URL }}/crm/service/leads/{{ $json.lead.id }}/assign",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contractVersion: '1', workflowExecutionId: $execution.id, workflowName: '04-sales-automation', assignedToId: $env.DEFAULT_SALES_OWNER_ID }) }}",
        "options": { "timeout": 10000 }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "HkpCn7QOHOauRVq1",
          "name": "EYAN Service API"
        }
      }
    },
    {
      "id": "n10",
      "name": "Slack Configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1760, -280],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ !!$env.SLACK_WEBHOOK_URL }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }
        }
      }
    },
    {
      "id": "n11",
      "name": "Send Slack Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "onError": "continueRegularOutput",
      "position": [1980, -380],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "authentication": "none",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: ':dart: Lead qualified: *' + $('Verify & Parse').item.json.lead.contactName + '*' + ($('Verify & Parse').item.json.lead.company ? ' (' + $('Verify & Parse').item.json.lead.company + ')' : '') + ' -- score ' + $('Verify & Parse').item.json.qualification.score + ', ' + ($('Verify & Parse').item.json.qualification.confidenceTier || 'unknown') + ' confidence, routed to *' + $('Verify & Parse').item.json.pipelineStage + '*.\\nRecommended: ' + $('Verify & Parse').item.json.qualification.recommendedAction }) }}",
        "options": { "timeout": 10000 }
      }
    },
    {
      "id": "n12",
      "name": "Email Configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [2200, -280],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ !!$env.SALES_NOTIFICATION_EMAIL_TO }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }
        }
      }
    },
    {
      "id": "n13",
      "name": "Send Email Notification",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "onError": "continueRegularOutput",
      "position": [2420, -380],
      "parameters": {
        "fromEmail": "={{ $env.SALES_NOTIFICATION_EMAIL_FROM || 'sales-automation@eyan.fyi' }}",
        "toEmail": "={{ $env.SALES_NOTIFICATION_EMAIL_TO }}",
        "subject": "={{ 'Lead qualified: ' + $('Verify & Parse').item.json.lead.contactName + ($('Verify & Parse').item.json.lead.company ? ' (' + $('Verify & Parse').item.json.lead.company + ')' : '') }}",
        "text": "={{ 'Score: ' + $('Verify & Parse').item.json.qualification.score + '\\nConfidence: ' + ($('Verify & Parse').item.json.qualification.confidenceTier || 'unknown') + '\\nPipeline stage: ' + $('Verify & Parse').item.json.pipelineStage + '\\nRecommended action: ' + $('Verify & Parse').item.json.qualification.recommendedAction + '\\n\\nSummary: ' + $('Verify & Parse').item.json.qualification.summary }}",
        "options": {}
      },
      "credentials": {
        "smtp": {
          "id": "SmtpAccountCred01",
          "name": "SMTP Account"
        }
      }
    }
  ],
  "connections": {
    "Webhook - Lead Qualified": {
      "main": [[{ "node": "Prepare Verification Input", "type": "main", "index": 0 }]]
    },
    "Prepare Verification Input": {
      "main": [[{ "node": "Compute Expected Signature", "type": "main", "index": 0 }]]
    },
    "Compute Expected Signature": {
      "main": [[{ "node": "Verify & Parse", "type": "main", "index": 0 }]]
    },
    "Verify & Parse": {
      "main": [[{ "node": "Signature Valid?", "type": "main", "index": 0 }]]
    },
    "Signature Valid?": {
      "main": [
        [{ "node": "Respond 202 Accepted", "type": "main", "index": 0 }],
        [{ "node": "Respond 401 Invalid Signature", "type": "main", "index": 0 }]
      ]
    },
    "Respond 202 Accepted": {
      "main": [[{ "node": "Assignment Needed?", "type": "main", "index": 0 }]]
    },
    "Assignment Needed?": {
      "main": [
        [{ "node": "Assign Salesperson", "type": "main", "index": 0 }],
        [{ "node": "Slack Configured?", "type": "main", "index": 0 }]
      ]
    },
    "Assign Salesperson": {
      "main": [[{ "node": "Slack Configured?", "type": "main", "index": 0 }]]
    },
    "Slack Configured?": {
      "main": [
        [{ "node": "Send Slack Notification", "type": "main", "index": 0 }],
        [{ "node": "Email Configured?", "type": "main", "index": 0 }]
      ]
    },
    "Send Slack Notification": {
      "main": [[{ "node": "Email Configured?", "type": "main", "index": 0 }]]
    },
    "Email Configured?": {
      "main": [
        [{ "node": "Send Email Notification", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
